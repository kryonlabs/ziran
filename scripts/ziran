#!/bin/sh
set -eu

bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

usage()
{
    echo 'usage: ziran check|ir|build|fmt [options] file.zi ...' >&2
    exit 2
}

test "$#" -gt 0 || usage
command=$1
shift
case "$command" in
    check) exec "$bin_dir/ziran-ir" --check-only "$@" ;;
    ir) exec "$bin_dir/ziran-ir" "$@" ;;
    fmt) exec "$bin_dir/zi-fmt" "$@" ;;
    build)
        test "$#" -gt 0 || usage
        case "$1" in
            --target=c) shift; exec "$bin_dir/ziran-c" --no-main "$@" ;;
            --target=go) shift; exec "$bin_dir/ziran-go" --no-main "$@" ;;
            --target=cpp) shift; exec "$bin_dir/ziran-cpp" --no-main "$@" ;;
            *) usage ;;
        esac
        ;;
    *) usage ;;
esac
