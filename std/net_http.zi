host_api :: #system_library "host_api";
// Network transport is an explicit host capability. The host adds a Bearer
// Authorization header when token is nonempty. It must not log that token.
// The request and response records have the same meaning in native targets
// and portable bundles.
HttpRequest :: struct {
    method: string
    url: string
    token: string
    accept: string
    content_type: string
    body: string
}

HttpResponse :: struct {
    status: s32
    body: string
    error: string
}

SendHost :: (request: HttpRequest) -> HttpResponse #foreign host_api;

#program_export
Send :: (request: HttpRequest) -> HttpResponse {
    return SendHost(request)
}
