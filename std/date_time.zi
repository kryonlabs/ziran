host_api :: #system_library "host_api";

// The host supplies local civil time, including timezone and daylight-saving
// decisions. day_of_year is zero-based, matching the platform tm convention.
LocalDateTime :: struct {
    year: s32
    month: s32
    day: s32
    day_of_year: s32
    hour: s32
    minute: s32
    second: s32
    valid: bool
}

LocalNowHost :: () -> LocalDateTime #foreign host_api;
UnixNowHost :: () -> s64 #foreign host_api;

#program_export
LocalNow :: () -> LocalDateTime {
    return LocalNowHost()
}

#program_export
UnixNow :: () -> s64 {
    return UnixNowHost()
}
