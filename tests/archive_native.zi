#import, file "spec/zip_linux_test.zi";
#import "mapped_file_linux"
#import "file_linux"

#program_export
main :: () -> s32 {
    bytes: [5]u8 = .[104, 101, 108, 108, 111]
    file := OpenReplace("mapping.bin")
    if !file.valid { return 10 }
    written := WriteAt(file, bytes[:], 0)
    if !CloseFile(file) || written != 5 { return 11 }
    mapping := MapPrivate("mapping.bin")
    if !mapping.valid { return cast(s32)(20 + mapping.length) }
    if mapping.length != 5 { return 12 }
    view := MappedBytes(mapping)
    if view.count != 5 || view[0] != 104 || view[4] != 111 { return 13 }
    view[0] = cast(u8)72
    if !UnmapFile(mapping) { return 14 }
    file = OpenRead("mapping.bin")
    if !file.valid { return 15 }
    read := ReadAt(file, bytes[:], 0)
    if !CloseFile(file) || read != 5 || bytes[0] != 104 { return 16 }
    if !RemoveFile("mapping.bin") || MapPrivate("mapping.bin").valid { return 17 }
    zip_result := SelfTest()
    if zip_result != 0 { return zip_result }
    return 0
}
