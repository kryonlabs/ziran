#import "utf8"

#program_export
SelfTest :: () -> s32 {
    text: string = "aé中🙂"
    if text.count != 10 || Count(text) != 4 { return 1 }
    if Next(text, 0) != 1 || Next(text, 1) != 3 ||
       Next(text, 3) != 6 || Next(text, 6) != 10 { return 2 }
    if Next(text, 10) != 10 || Next(text, -1) != 0 { return 3 }
    return 42
}
