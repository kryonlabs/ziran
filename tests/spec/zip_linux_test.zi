#import "zip"
#import "zip_linux"

Put16 :: (buffer: []u8, at: s32, value: u32) {
    buffer[at] = cast(u8)value
    buffer[at + 1] = cast(u8)(value >> 8)
}

Put32 :: (buffer: []u8, at: s32, value: u32) {
    Put16(buffer, at, value)
    Put16(buffer, at + 2, value >> 16)
}

#program_export
SelfTest :: () -> s32 {
    // Raw DEFLATE of "hello" inside a single-entry classic ZIP file.
    bytes: [107]u8
    Put32(bytes[:], 0, cast(u32)0x04034b50)
    Put16(bytes[:], 4, 20)
    Put16(bytes[:], 8, 8)
    Put32(bytes[:], 14, cast(u32)0x3610a686)
    Put32(bytes[:], 18, 7)
    Put32(bytes[:], 22, 5)
    Put16(bytes[:], 26, 1)
    bytes[30] = cast(u8)97
    bytes[31] = cast(u8)203
    bytes[32] = cast(u8)72
    bytes[33] = cast(u8)205
    bytes[34] = cast(u8)201
    bytes[35] = cast(u8)201
    bytes[36] = cast(u8)7
    bytes[37] = cast(u8)0
    Put32(bytes[:], 38, cast(u32)0x02014b50)
    Put16(bytes[:], 42, 20)
    Put16(bytes[:], 44, 20)
    Put16(bytes[:], 48, 8)
    Put32(bytes[:], 54, cast(u32)0x3610a686)
    Put32(bytes[:], 58, 7)
    Put32(bytes[:], 62, 5)
    Put16(bytes[:], 66, 1)
    bytes[84] = cast(u8)97
    Put32(bytes[:], 85, cast(u32)0x06054b50)
    Put16(bytes[:], 93, 1)
    Put16(bytes[:], 95, 1)
    Put32(bytes[:], 97, 47)
    Put32(bytes[:], 101, 38)
    entry: ZipEntry = FindZipEntry(bytes[:], "a")
    if !entry.found || entry.method != 8 || entry.size != 5 { return 1 }
    output: [5]u8
    if !ExtractZipEntry(bytes[:], entry, output[:]) ||
       output[0] != cast(u8)104 || output[4] != cast(u8)111 { return 2 }
    bytes[34] = cast(u8)0
    if ExtractZipEntry(bytes[:], entry, output[:]) { return 3 }
    return 0
}
