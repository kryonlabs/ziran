#import "file_linux"

#program_export
main :: () -> s32 {
    if !CreateDirectory("files") { return 1 }
    original := OpenUpdate("files/original")
    destination := OpenReplace("files/destination")
    if !original.valid || !destination.valid { return 2 }
    bytes: [3]u8 = .[17, 128, 255]
    // A sparse offset beyond 32-bit off_t catches truncated offset adapters.
    offset: s64 = 4294967303
    if WriteAt(original, bytes[:], offset) != 3 ||
        FileSize(original) != offset + 3 { return 3 }
    actual: [3]u8
    if ReadAt(original, actual[:], offset) != 3 ||
        actual[0] != 17 || actual[1] != 128 || actual[2] != 255 { return 4 }
    if !CloseFile(original) || !CloseFile(destination) { return 5 }
    if RenameNoReplace("files/original", "files/destination") ||
        !PathExists("files/original") || !PathExists("files/destination") { return 6 }
    if !RemoveFile("files/destination") ||
        !RenameNoReplace("files/original", "files/destination") ||
        PathExists("files/original") { return 7 }
    if !CreateDirectory("files/old") || !CreateDirectory("files/new") { return 8 }
    if RenameNoReplace("files/old", "files/new") ||
        !DirectoryExists("files/old") || !DirectoryExists("files/new") { return 9 }
    if !RenameNoReplace("files/old", "files/moved") ||
        DirectoryExists("files/old") || !DirectoryExists("files/moved") { return 10 }
    return 0
}
