#import "byte_text_linux"

#program_export
main :: () -> s32 {
    bytes: [5]u8 = .[65, 0, 195, 169, 0]
    whole := TextFromBytes(bytes[0:4])
    if whole.count != 4 || whole[0] != 65 || whole[1] != 0 ||
        whole[2] != 195 || whole[3] != 169 { return 1 }
    terminated := TextFromCString(*bytes[0])
    if terminated != "A" || terminated.count != 1 { return 2 }
    unicode := TextFromCString(*bytes[2])
    if unicode != "é" || unicode.count != 2 { return 3 }
    if TextFromCString(null) != "" || TextFromBytes(bytes[0:0]) != "" {
        return 4
    }
    borrowed := BytesFromPointer(*bytes[0], 4)
    if borrowed.count != 4 || TextFromBytes(borrowed) != whole { return 5 }
    bytes[0] = cast(u8)66
    if whole[0] != 66 || terminated != "B" { return 6 }
    if BytesFromPointer(null, 1).count != 0 { return 7 }
    return 0
}
